# ============================================================
#  拾声 (XianDial) 硬件版 —— 发布版 .gitignore
#  目标：空台单 + 不泄露任何敏感内容
# ============================================================

# ---- ① 编译产物 ----
build/
build_pub/
# ★★ 10-07 补：build_en/ —— 英文版的构建目录 -------------------------
#   漏了这条的后果：`en/build_en/` 会被判成「未跟踪且未被忽略的新文件」，
#   于是 ① `git add -A` 会把整棵构建树（CMakeCache / CMakeConfigureLog，
#   里面记着本机用户目录与 IDF 安装路径）一起提交；
#   ② 泄漏扫描器要把 3700+ 行构建日志当成待发布内容逐行扫，
#   真正的命中被淹没在噪声里（闸门因此长年报红，久了就没人看）。
#   ⚠️ 本注释本身【不要】写出那条路径的字面量 —— 扫描器会把它当成泄漏命中。
#   写法用 `build_en/`（不带前导斜杠）⇒ 匹配任意层级的同名目录，
#   所以既盖住 `build_en/`，也盖住 `en/build_en/`。
build_en/
sdkconfig.old
*.elf
*.map
*.bin.part

# ---- ② ★ 台单字库：只排【自用版】，发布版字库必须进仓库 ----
#   自用版 xs_font_st12/16.c 是拿【1254 个真实台名里出现的字】烘出来的字形。
#   台单文件置空了、这两个文件照旧进仓库，
#   等于把台单以【字形】形式留在固件里 —— 置空白做。
#   ⇒ 排除它们。
#
#   ⚠️ 通配符 `xs_font_st*.c` 【不匹配】发布版的 xs_font_pub_st12.c
#      （pub 在 st 前面），所以发布包自带通用汉字字库、能开箱即编。
#      ★ 这一点改文件名时极易踩：若把发布版改名成 xs_font_st12_pub.c，
#        会被这条规则一起排掉，发布包就缺字库、链接期报 undefined reference。
#        已用 fnmatch 逐个验证过（2026-09-15）。
main/fonts/xs_font_st*.c
main/fonts/xs_font_st*.bin
main/fonts/_old_simhei_10MB/

# ---- ②b ★ 已废弃内容的本地归档（绝不入库）----
#   main/_retired/ 是我把废弃文件移过去的地方（不是删，是挪）：
#     xs_font_st24.c        死符号档位，1.21 MiB，已从 CMakeLists 与 UI 移除
#     _old_simhei_10MB/     旧专有字体（simhei/Deng）留档，权利人是中易+方正
#   ⚠️ 里面的 simhei 字库是【专有字体】，绝对不能进公开仓库。
#     移到 _retired/ 只是为了本地还能翻查，不是「归档即可发布」。
main/_retired/
_retired/

# ---- ③ 字体源文件（体积大，且授权需各自带 OFL）----
#   Ark Pixel 与思源黑体的 .ttf/.otf 本体不入库（合计 ~20 MB），
#   但两份 OFL-1.1 授权文本必须随包（下面 !OFL-*.txt 放行）。
_fontsrc/
*.ttf
*.otf
*.zip
!OFL-*.txt

# ---- ④ ★ 台单数据（自用版才有的那一批）----
#   net_stations.c / .h 是【自用版】产物（含港澳台/海外真实地址）。
#   发布版改用 net_stations_pub.c / .h（0 条，约 1.2 KB）—— 这份进仓库。
#   ⇒ 仓库里只保留 _pub 那份；自用版文件本地保留、不提交。
main/net_stations.c
main/net_stations.h

# ---- ④b ★ 收藏播种名单（10-06：源码扫描查不出来的那类泄漏）----
#   net_stations_seed.h 里是兰兰常听的 10 个真实台名（上海戏曲广播、上海交通、
#   上海第一财经、宁波交通…）。它原本硬编码在 app_fav.c 的 k_seed[] 里，
#   结果发布版固件的 .bin 里带着这五个台名 —— 不是 URL、不是路径、不是凭据，
#   只是一个中文字符串，_release_gitscan 规则全绿也照样漏过去，
#   最后是靠【直接 grep 编译产物】抓到的。
#   ⇒ 名单本体随台单版本走：自用版这份排除，发布版【不 include 任何名单】
#     （CMakeLists 用 XS_FAV_PUBLISH 宏关掉播种）。
main/net_stations_seed.h

# ---- ④c ★ 版本排障笔记（10-06 隐私审计第三版）----
#   app_version_note_local.h 里是 v1.51 的完整排障记录，含【第三方公网电台 IP】
#   （排查 https 失败时用 st_net 测过的目标）与兰兰的诊断过程。
#   它不是"预置的服务器地址"，但发布版二进制带着它 ⇒ 会被读成有固定出站目标。
#   ⇒ 只本地保留；发布版 app_version.h 走 XS_FAV_PUBLISH 分支的简短说明。
main/app_version_note_local.h

# ---- ⑤ ★ 本机路径 / 账号 / 凭据（一律不能进仓库）----
*.bak
*.bak-*
_reveal/
sdkconfig.defaults.local
build_manifest*.json
_build*.log
_fw_snap*.json

# ---- ⑥ 私有数据源（生成器读它们抽台单）----
_live_stations*.json
_stations_hai.json
xixiazi/
xianghai-private/

# ---- ⑦ 日常脚本的临时产物 ----
_flash.log
_stnet.log
_probe_formats.out
_test_stations.tsv

# ---- ⑧ 工具缓存 ----
__pycache__/
*.pyc
.venv/
node_modules/

# ---- ⑧b ★ ESP-IDF 自动拉取的第三方组件（10-06 扫描时才发现）----
#   managed_components/ 是 idf.py build 时按 dependencies.lock 自动 clone 的
#   （lvgl__lvgl 一个就 6980 个文件、含全部 docs/demo/devcontainer）。
#   ★ 它们不是我们的源码，进仓库会造成三个问题：
#     ① 体积：单 LVGL 就几十 MB，仓库瞬间变重、clone 变慢；
     ② 许可：LVGL 是 MIT，但把别人的 docs/CI 配置混进自己的仓库，
#        让人误以为是我们的作品；
     ③ 安全：docs 里那些 /home/joe/、邮箱、"E:cursor.png" 之类的字符串
#        会被发布扫描当成泄漏，白花时间排查（我第一次跑扫描就被它刷了 100 条）。
#   ⇒ 靠 dependencies.lock + main/idf_component.yml 恢复，clone 下来
#     第一次 build 会自动重新拉（需要网络）。
managed_components/

# ---- ⑨ 编辑器 ----
.vscode/
.idea/
*.swp
*~
